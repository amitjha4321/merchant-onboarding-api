# Copy to .env and fill in the values. Never commit .env.
# Generate secrets with:  openssl rand -base64 48   (JWT)  /  openssl rand -base64 32   (field key)

NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=merchant
DB_PASSWORD=
DB_NAME=merchant_onboarding
# Apply pending migrations on app boot (convenient locally; prefer a release step in prod)
DB_MIGRATIONS_RUN=true

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=merchant

# --- Auth ---
# >= 32 chars, required. The app refuses to boot without it.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- Field-level encryption (AES-256-GCM). base64 of exactly 32 random bytes. ---
FIELD_ENCRYPTION_KEY=

# --- Risk worker ---
RISK_JOB_ATTEMPTS=5
RISK_JOB_BACKOFF_MS=2000
RISK_WORKER_CONCURRENCY=5
# Run the BullMQ worker inside the API process (false = API-only node)
RISK_WORKER_ENABLED=true
# Simulated KYB provider behaviour
RISK_PROVIDER_LATENCY_MS=300
RISK_PROVIDER_FAILURE_RATE=0.2

# --- Seed script (npm run seed). Used only to create local demo users. ---
SEED_DEFAULT_PASSWORD=
